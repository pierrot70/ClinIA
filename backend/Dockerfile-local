FROM node:20-alpine

WORKDIR /app

# Installe exactement les dépendances du lockfile, incluant les outils de test.
COPY package.json package-lock.json ./
RUN npm ci

# Code (sera ensuite écrasé/complété par le volume en compose)
COPY . .

EXPOSE 4000

# PROD: démarrage direct node index.js pour diagnostic
CMD ["node", "-r", "dotenv/config", "index.js"]
