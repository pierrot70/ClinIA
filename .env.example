# ClinIA example environment file — DO NOT COMMIT SECRETS
# Copy to `.env` and fill values before running locally or in production.

# OpenAI
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=

# ClinIA behaviour
CLINIA_MOCK_AI=1
NODE_ENV=development
# Self-registration is disabled unless explicitly enabled.
CLINIA_ALLOW_SELF_REGISTRATION=false

# JWT
JWT_SECRET=

# Mongo (example placeholders)
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=
MONGO_APP_USERNAME=clinia_app
MONGO_APP_PASSWORD=
MONGO_URI=mongodb://clinia_app:password@localhost:27017/clinia?authSource=clinia
MONGO_URI_DOCKER=mongodb://clinia_app:password@mongo:27017/clinia?authSource=clinia
MONGO_ADMIN_URI_DOCKER=mongodb://root:password@mongo:27017/?authSource=admin
MONGO_EXPRESS_USERNAME=
MONGO_EXPRESS_PASSWORD=

# Frontend
VITE_API_URL=http://localhost:4000
CLINIA_ALLOWED_ORIGINS=http://localhost:5173
