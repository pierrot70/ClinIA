# ClinIA example environment file — DO NOT COMMIT SECRETS
# Copy to `.env` and fill values before running locally or in production.

# OpenAI
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=

# ClinIA behaviour
CLINIA_MOCK_AI=1
NODE_ENV=development

# JWT
JWT_SECRET=

# Mongo (example placeholders)
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=
# If you prefer a full URI (example):
# MONGO_URI=mongodb://root:password@mongo:27017/clinia?authSource=admin

# Frontend
VITE_API_URL=http://localhost:4000
